{
  "name": "experiment-agent",
  "version": "0.0.0",
  "private": true,
  "description": "실험보고서 학습 보조 Agent",
  "author": "sxcrxta",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run check && electron-vite build",
    "preview": "electron-vite preview",
    "check": "npm run check:boundaries && npm run check:types && npm run lint && npm run test",
    "check:boundaries": "vitest run tests/boundaries.test.ts",
    "check:types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:v1": "vitest run --config vitest.integration.config.ts",
    "stages": "node tools/stages/cli.mts",
    "stage": "node tools/stages/cli.mts --stage",
    "package": "npm run build && electron-builder --mac --config electron-builder.yml"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "fflate": "^0.8.3",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "electron@44.3.0": true
  }
}
